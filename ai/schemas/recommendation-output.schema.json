{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CollaboratorRecommendationOutput",
  "description": "Skema output JSON untuk rekomendasi kolaborator mahasiswa (V2)",
  "type": "object",
  "required": [
    "query_user_id",
    "recommendations"
  ],
  "properties": {
    "query_user_id": {
      "type": "string",
      "description": "ID unik pengguna yang meminta rekomendasi"
    },
    "fallback": {
      "type": "boolean",
      "description": "Menandai apakah output dihasilkan dari mode fallback / degradasi cepat",
      "default": false
    },
    "recommendations": {
      "type": "array",
      "description": "Daftar kandidat kolaborator yang direkomendasikan",
      "items": {
        "type": "object",
        "required": [
          "user_id",
          "score",
          "matched_terms",
          "complementary_skills",
          "reason"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "description": "ID calon rekan kolaborator"
          },
          "rec_id": {
            "type": ["integer", "null"],
            "description": "ID unik log rekomendasi untuk pengiriman feedback relevansi"
          },
          "name": {
            "type": "string",
            "description": "Nama lengkap mahasiswa kandidat"
          },
          "department": {
            "type": "string",
            "description": "Program studi kandidat"
          },
          "match_level": {
            "type": "string",
            "enum": [
              "Sangat Cocok",
              "Cukup Cocok",
              "Potensial"
            ],
            "description": "Label tingkatan kecocokan ramah pengguna"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Skor kemiripan/kecocokan relatif (0.0 sampai 1.0)"
          },
          "matched_terms": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Istilah keahlian atau minat yang memiliki irisan"
          },
          "complementary_skills": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Keahlian kandidat yang melengkapi kekurangan proyek/pengguna"
          },
          "reason": {
            "type": "string",
            "description": "Penjelasan bahasa alami transparan mengenai alasan kecocokan profil"
          }
        }
      }
    }
  }
}

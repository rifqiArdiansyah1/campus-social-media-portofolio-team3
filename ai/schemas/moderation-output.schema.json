{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContentModerationOutput",
  "description": "Skema output JSON untuk hasil klasifikasi moderasi konten teks feed",
  "type": "object",
  "required": [
    "post_id",
    "label",
    "categories",
    "confidence",
    "explanation"
  ],
  "properties": {
    "post_id": {
      "type": "string",
      "description": "ID unik postingan yang diperiksa"
    },
    "label": {
      "type": "string",
      "enum": [
        "aman",
        "perlu_review",
        "berpotensi_melanggar"
      ],
      "description": "Status rekomendasi keputusan awal moderasi"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Kategori potensi pelanggaran (e.g. ujaran_kasar, pelecehan, spam, penipuan)"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Tingkat kepastian klasifikasi model (0.0 sampai 1.0)"
    },
    "explanation": {
      "type": "string",
      "description": "Alasan singkat mengapa konten diberi label tersebut"
    }
  }
}

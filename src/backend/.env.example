# CampusFolio Backend Environment Configuration
PROJECT_NAME="CampusFolio API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENV="development"

# Keamanan JWT (Minimal 32 karakter unik untuk production)
SECRET_KEY="ganti-dengan-secret-key-aman-milik-tim-campusfolio-minimal-32-karakter"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database PostgreSQL (Supabase Cloud Free Tier)
# Gunakan Session Pooler (port 5432) untuk koneksi IPv4 yang stabil
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Dedicated Migration Database URL (Opsional, fallback ke DATABASE_URL bila tidak diisi)
# Disarankan memakai session/direct connection port 5432 (bukan transaction pooler) untuk eksekusi DDL Alembic
# MIGRATION_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Storage & Services
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"
POST_IMAGES_BUCKET="post-images"
PORTFOLIO_DOCS_BUCKET="portfolio-docs"
STORAGE_LOCAL_FALLBACK_DIR="uploads"

# Allowed Email Domains for Registration (US-01)
ALLOWED_EMAIL_DOMAINS="campus.ac.id,students.campus.ac.id"

# CORS Origins (Izinkan Next.js Web lokal & domain hosted Vercel, jangan gunakan '*' bersama credentials)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

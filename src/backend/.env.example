# CampusFolio Backend Environment Configuration
PROJECT_NAME="CampusFolio API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Keamanan JWT
SECRET_KEY="ganti-dengan-secret-key-aman-milik-tim-campusfolio"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database PostgreSQL (Supabase Cloud Free Tier)
# Ganti [YOUR-PASSWORD] dan [YOUR-PROJECT-REF] sesuai project Supabase Anda
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# CORS Origins (Izinkan Flutter Web lokal & hosted)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:3000","*"]

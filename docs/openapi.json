  "components": {
    "schemas": {
      "AdminCreateUserRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 100,
            "title": "Email",
            "description": "Email resmi staf/admin"
          },
          "nama": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Nama",
            "description": "Nama staf/admin"
          },
          "password": {
            "type": "string",
            "title": "Password",
            "description": "Kata sandi sementara (minimal 8 karakter, maksimal 72 byte UTF-8)"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "Peran akun baru: 'moderator' atau 'admin'"
          },
          "jurusan": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Jurusan",
            "description": "Program studi binaan (wajib untuk moderator)"
          },
          "nim": {
            "type": "string",
            "maxLength": 20,
            "minLength": 3,
            "title": "Nim",
            "description": "Nomor identitas/NIP staf"
          },
          "angkatan": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Angkatan",
            "description": "Tahun angkatan opsional"
          }
        },
        "type": "object",
        "required": [
          "email",
          "nama",
          "password",
          "role",
          "nim"
        ],
        "title": "AdminCreateUserRequest"
      },
      "CandidateProfile": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "department": {
            "type": "string",
            "title": "Department"
          },
          "bio": {
            "type": "string",
            "title": "Bio",
            "default": ""
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skills",
            "default": []
          },
          "interests": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Interests",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "name",
          "department"
        ],
        "title": "CandidateProfile"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 100,
            "title": "Email",
            "description": "Email kampus atau NIM terdaftar"
          },
          "password": {
            "type": "string",
            "title": "Password",
            "description": "Kata sandi akun"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "ModerationRequest": {
        "properties": {
          "post_id": {
            "type": "string",
            "title": "Post Id"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          }
        },
        "type": "object",
        "required": [
          "post_id",
          "content"
        ],
        "title": "ModerationRequest"
      },
      "ModerationResponse": {
        "properties": {
          "post_id": {
            "type": "string",
            "title": "Post Id"
          },
          "label": {
            "type": "string",
            "enum": [
              "aman",
              "perlu_review",
              "berpotensi_melanggar"
            ],
            "title": "Label"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Categories",
            "description": "Violation categories (e.g. ujaran_kasar, pelecehan, spam)"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "description": "Confidence score"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation",
            "description": "Explanation of classification"
          }
        },
        "type": "object",
        "required": [
          "post_id",
          "label",
          "confidence",
          "explanation"
        ],
        "title": "ModerationResponse"
      },
      "MyProfileResponse": {
        "properties": {
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "nim": {

  "components": {
    "schemas": {
      "AdminCreateUserRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 100,
            "title": "Email",
            "description": "Email resmi staf/admin"
          },
          "nama": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Nama",
            "description": "Nama staf/admin"
          },
          "password": {
            "type": "string",
            "title": "Password",
            "description": "Kata sandi sementara (minimal 8 karakter, maksimal 72 byte UTF-8)"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "Peran akun baru: 'moderator' atau 'admin'"
          },
          "jurusan": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Jurusan",
            "description": "Program studi binaan (wajib untuk moderator)"
          },
          "nim": {
            "type": "string",
            "maxLength": 20,
            "minLength": 3,
            "title": "Nim",
            "description": "Nomor identitas/NIP staf"
          },
          "angkatan": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Angkatan",
            "description": "Tahun angkatan opsional"
          }
        },
        "type": "object",
        "required": [
          "email",
          "nama",
          "password",
          "role",
          "nim"
        ],
        "title": "AdminCreateUserRequest"
      },
      "CandidateProfile": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "department": {
            "type": "string",
            "title": "Department"
          },
          "bio": {
            "type": "string",
            "title": "Bio",
            "default": ""
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skills",
            "default": []
          },
          "interests": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Interests",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "name",
          "department"
        ],
        "title": "CandidateProfile"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 100,
            "title": "Email",
            "description": "Email kampus atau NIM terdaftar"
          },
          "password": {
            "type": "string",
            "title": "Password",
            "description": "Kata sandi akun"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "ModerationRequest": {
        "properties": {
          "post_id": {
            "type": "string",
            "title": "Post Id"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          }
        },
        "type": "object",
        "required": [
          "post_id",
          "content"
        ],
        "title": "ModerationRequest"
      },
      "ModerationResponse": {
        "properties": {
          "post_id": {
            "type": "string",
            "title": "Post Id"
          },
          "label": {
            "type": "string",
            "enum": [
              "aman",
              "perlu_review",
              "berpotensi_melanggar"
            ],
            "title": "Label"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Categories",
            "description": "Violation categories (e.g. ujaran_kasar, pelecehan, spam)"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "description": "Confidence score"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation",
            "description": "Explanation of classification"
          }
        },
        "type": "object",
        "required": [
          "post_id",
          "label",
          "confidence",
          "explanation"
        ],
        "title": "ModerationResponse"
      },
      "RecommendationItem": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "department": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Department"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "description": "Similarity score between 0.0 and 1.0"
          },
          "matched_terms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matched Terms",
            "description": "Matched skills/interests"
          },
          "complementary_skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Complementary Skills",
            "description": "Skills that complement the seeker"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "description": "Natural language explanation of match"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "score",
          "reason"
        ],
        "title": "RecommendationItem"
      },
      "RecommendationQuery": {
        "properties": {
          "query_user_id": {
            "type": "string",
            "title": "Query User Id"
          },
          "target_skills": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Skills",
            "description": "Skills specifically needed for project"
          },
          "project_description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Description",
            "description": "Optional project requirement text",
            "default": ""
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 5
          }
        },
        "type": "object",
        "required": [
          "query_user_id"
        ],
        "title": "RecommendationQuery"
      },
      "RecommendationResponse": {
        "properties": {
          "query_user_id": {
            "type": "string",
            "title": "Query User Id"
          },
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/RecommendationItem"
            },
            "type": "array",
            "title": "Recommendations"
          }
        },
        "type": "object",
        "required": [
          "query_user_id",
          "recommendations"
        ],
        "title": "RecommendationResponse"
      },
      "RegisterRequest": {
        "properties": {
          "nim": {
            "type": "string",
            "maxLength": 20,
            "minLength": 5,
            "title": "Nim",
            "description": "Nomor Induk Mahasiswa"
          },
          "nama": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Nama",
            "description": "Nama lengkap mahasiswa"
          },
          "email": {
            "type": "string",
            "maxLength": 100,
            "title": "Email",
            "description": "Email resmi kampus"
          },
          "password": {
            "type": "string",
            "title": "Password",
            "description": "Kata sandi (minimal 8 karakter, maksimal 72 byte UTF-8)"
          },
          "jurusan": {
            "type": "string",
            "maxLength": 100,
            "title": "Jurusan",
            "description": "Program studi / Jurusan resmi"
          },
          "angkatan": {
            "type": "integer",
            "minimum": 2015.0,
            "title": "Angkatan",
            "description": "Tahun angkatan masuk"
          },
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Role",
            "description": "Diabaikan untuk registrasi mandiri, selalu dipaksa 'mahasiswa'"
          }
        },
        "type": "object",
        "required": [
          "nim",
          "nama",
          "email",
          "password",
          "jurusan",
          "angkatan"
        ],
        "title": "RegisterRequest"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          },
          "user": {
            "$ref": "#/components/schemas/UserProfileResponse"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_in",
          "user"
        ],
        "title": "TokenResponse"
      },
      "UserProfileResponse": {
        "properties": {
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "nim": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nim"
          },
          "nama": {
            "type": "string",
            "title": "Nama"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "jurusan": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jurusan"
          },
          "angkatan": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Angkatan"
          },
          "bio": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bio"
          },
          "kontak_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kontak Url"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "id": {
            "type": "integer",
            "title": "Id",
            "readOnly": true
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "nama",
          "email",
          "role",
          "created_at",
          "id"
        ],
        "title": "UserProfileResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}

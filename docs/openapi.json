{
  "openapi": "3.1.0",
  "info": {
    "title": "CampusFolio API",
    "description": "Backend API & Layanan AI untuk CampusFolio — Campus Social Media & Portfolio (Team 3)",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Authentication & RBAC (M02)"
        ],
        "summary": "Registrasi Akun Mahasiswa Baru",
        "description": "Mendaftarkan akun mahasiswa baru (US-01).\n- Memvalidasi domain email resmi kampus (@campus.ac.id / @students.campus.ac.id)\n- Memvalidasi daftar prodi resmi kampus\n- Membatasi kata sandi antara 8 hingga 72 byte UTF-8\n- Memaksa peran akun selalu menjadi 'mahasiswa' (mencegah eskalasi hak akses)\n- Menangani duplikasi NIM dan email dengan status 409 (NIM_TAKEN / EMAIL_TAKEN)",
        "operationId": "register_api_v1_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Authentication & RBAC (M02)"
        ],
        "summary": "Masuk / Otentikasi Pengguna",
        "description": "Masuk ke sistem menggunakan email dan kata sandi.\n- Dilindungi rate limiter 2 lapis (IP+Email dan Global Email)\n- Mitigasi timing attack dengan dummy bcrypt hashing saat email tidak ditemukan\n- Menangani kata sandi > 72 byte secara elegan sebagai 401 INVALID_CREDENTIALS\n- Mengembalikan JWT stateless dengan masa berlaku 24 jam",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "Authentication & RBAC (M02)"
        ],
        "summary": "Profil Pengguna Sesi Aktif",
        "description": "Mengambil data profil pengguna yang sedang login berdasarkan token JWT aktif.",
        "operationId": "get_current_user_profile_api_v1_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Authentication & RBAC (M02)"
        ],
        "summary": "Keluar dari Sesi",
        "description": "Keluar dari sesi (stateless JWT).\nKlien diharapkan menghapus token dari storage lokal / cookie.",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/v1/admin/users": {
      "post": {
        "tags": [
          "Administration (M02)"
        ],
        "summary": "Pembuatan Akun Staf/Moderator/Admin (Khusus Administrator)",
        "description": "Endpoint khusus administrator untuk membuat akun baru berwenang (moderator/admin).\n- Menolak pembuatan moderator tanpa jurusan spesifik (422 MODERATOR_JURUSAN_REQUIRED)\n- Memvalidasi jurusan moderator terhadap daftar prodi resmi kampus (422 INVALID_JURUSAN)\n- Mengizinkan unit administratif untuk akun role 'admin'\n- Menangani duplikasi email dan identitas unik",
        "operationId": "admin_create_user_api_v1_admin_users_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminCreateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/recommendations/match": {
      "post": {
        "tags": [
          "AI Recommendations (AI-1)"
        ],
        "summary": "Rekomendasi Kolaborator Mahasiswa (AI-1)",
        "description": "Endpoint AI-1: Menganalisis kemiripan semantik dan keahlian komplementer\nuntuk merekomendasikan rekan proyek/lomba mahasiswa.",
        "operationId": "get_collaborator_recommendations_api_v1_recommendations_match_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendationQuery"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recommendations/candidates": {
      "get": {
        "tags": [
          "AI Recommendations (AI-1)"
        ],
        "summary": "Daftar Profil Mahasiswa (Dummy/Sample)",
        "operationId": "list_candidates_api_v1_recommendations_candidates_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CandidateProfile"
                  },
                  "type": "array",
                  "title": "Response List Candidates Api V1 Recommendations Candidates Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/moderation/check": {
      "post": {
        "tags": [
          "AI Content Moderation (AI-2)"
        ],
        "summary": "Klasifikasi Awal Moderasi Postingan (AI-2)",
        "description": "Endpoint AI-2: Memindai teks postingan sebelum/sesudah tayang.\nHasil klasifikasi menentukan apakah postingan langsung tayang (aman),\nditinjau admin (perlu_review), atau disembunyikan (berpotensi_melanggar).",
        "operationId": "check_post_moderation_api_v1_moderation_check_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModerationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModerationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },

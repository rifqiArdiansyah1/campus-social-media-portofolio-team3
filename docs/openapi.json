        ],
        "summary": "Keluar dari Sesi",
        "description": "Keluar dari sesi (stateless JWT).\nKlien diharapkan menghapus token dari storage lokal / cookie.",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/v1/admin/users": {
      "post": {
        "tags": [
          "Administration (M02)"
        ],
        "summary": "Pembuatan Akun Staf/Moderator/Admin (Khusus Administrator)",
        "description": "Endpoint khusus administrator untuk membuat akun baru berwenang (moderator/admin).\n- Menolak pembuatan moderator tanpa jurusan spesifik (422 MODERATOR_JURUSAN_REQUIRED)\n- Memvalidasi jurusan moderator terhadap daftar prodi resmi kampus (422 INVALID_JURUSAN)\n- Mengizinkan unit administratif untuk akun role 'admin'\n- Menangani duplikasi email dan identitas unik",
        "operationId": "admin_create_user_api_v1_admin_users_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminCreateUserRequest"
              }
            }
          },
          "required": true
        },

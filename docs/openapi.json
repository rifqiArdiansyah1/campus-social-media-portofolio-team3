              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nim"
          },
          "nama": {
            "type": "string",
            "title": "Nama"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "jurusan": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jurusan"
          },
          "angkatan": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Angkatan"
          },
          "bio": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bio"
          },
          "kontak_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kontak Url"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "skills": {
            "items": {
              "$ref": "#/components/schemas/UserSkillResponse"
            },
            "type": "array",
            "title": "Skills",
            "default": []
          },
          "id": {
            "type": "integer",
            "title": "Id",
            "readOnly": true
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "nama",
          "email",
          "role",
          "created_at",
          "id"
        ],
        "title": "MyProfileResponse"
